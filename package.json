{
  "name": "liubai-planner",
  "productName": "冲冲冲",
  "version": "0.4.0",
  "private": true,
  "description": "冲冲冲，一天一张卡片的个人日程本。",
  "author": "zewbby",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "tsc -b && vite build",
    "build:icons": "node scripts/build-icon.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test src/lib/*.test.ts && node --test cloudflare/test/*.test.mjs",
    "package:win": "pnpm build && electron-builder --win nsis --x64 --config.electronDist=node_modules/electron/dist",
    "package:portable": "pnpm build && electron-builder --win portable --x64 --config.electronDist=node_modules/electron/dist",
    "package:mac": "pnpm build && electron-builder --mac dmg"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0",
    "typescript": "~5.9.3",
    "tsx": "^4.20.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "@playwright/test": "^1.56.0"
  },
  "build": {
    "appId": "app.liubai.planner",
    "productName": "冲冲冲",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "assets/**/*", "package.json"],
    "asar": true,
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "assets/app-icon.ico", "signExecutable": false },
    "nsis": {
      "artifactName": "ChongChongChong-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "冲冲冲",
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "portable": { "artifactName": "ChongChongChong-${version}-Windows.${ext}" },
    "mac": { "target": "dmg", "category": "public.app-category.productivity" }
  }
}
